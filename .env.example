# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Discord channel → Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# eBay developer production keyset: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# Optional: Discord bot for !add / !remove / !list commands
# https://discord.com/developers/applications → New Application → Bot → Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Right-click the commands channel → Copy Channel ID (needs Developer Mode on)
DISCORD_COMMAND_CHANNEL_ID=your_channel_id_here
# Discord app → General Information → Public Key (for /slash commands on Netlify)
DISCORD_PUBLIC_KEY=your_discord_public_key_here
